 //OS-specific prefix(s)
 // NOTE: PREFIX, L_ETCDIR, L_SHAREDIR are defined in the OS-detect.pri project file and passed in
-QString LOS::LuminaShare(){ return (L_SHAREDIR+"/lumina-desktop/"); } //Install dir for Lumina share files
+//Install dir for Lumina share files
+//Honour a relocated install (AppImage, custom prefix) when APPDIR is set,
+//this is what makes the desktop work outside of /usr
+QString LOS::LuminaShare(){
+  QString share = QString(getenv("LUMINA_SHARE_DIR")).simplified();
+  if(!share.isEmpty()){ return share.endsWith("/") ? share : share+"/"; }
+  return (L_SHAREDIR+"/lumina-desktop/");
+}
 QString LOS::AppPrefix(){ return "/usr/"; } //Prefix for applications
